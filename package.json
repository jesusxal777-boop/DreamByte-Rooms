{
  "name": "dreambyte-rooms",
  "version": "1.0.0",
  "description": "DreamByte Rooms - Discord bot for multi-AI collaborative conversations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "register-commands": "tsx src/registerCommands.ts"
  },
  "keywords": ["discord", "bot", "ai", "multi-agent", "dreambyte"],
  "author": "DreamByte",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "@anthropic-ai/sdk": "^0.27.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.8.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

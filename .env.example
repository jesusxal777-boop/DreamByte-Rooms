# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID (Application ID)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional: Guild ID for development (faster command registration)
# DISCORD_GUILD_ID=your_test_guild_id_here

# OpenAI API Key (for ChatGPT / GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI API Key (for Grok)
XAI_API_KEY=your_xai_api_key_here

# Google AI API Key (for Gemini) - optional for MVP
GOOGLE_API_KEY=your_google_api_key_here

# Default model overrides (optional)
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# XAI_MODEL=grok-beta
